# 智会后端服务环境变量模板
# 复制此文件为 .env 并填入真实值

# ==================== TRTC 配置 ====================
# 腾讯云实时音视频 SDK App ID (从 TRTC 控制台获取)
TRTC_SDK_APP_ID=your_sdk_app_id_here
# TRTC 密钥 (从 TRTC 控制台获取)
TRTC_SECRET_KEY=your_secret_key_here

# ==================== 腾讯云 API 密钥 ====================
# 用于云录制等后端服务 (从腾讯云访问管理获取)
TENCENT_SECRET_ID=your_secret_id_here
TENCENT_SECRET_KEY=your_secret_key_here

# ==================== COS 配置 ====================
# 用于存储录制文件
COS_BUCKET=your_bucket_name
COS_REGION=ap-hongkong

# ==================== 服务配置 ====================
PORT=3001

# ==================== UniAuth SSO 配置 ====================
# 从 UniAuth 管理后台获取
UNIAUTH_BASE_URL=https://your-sso-domain.com
UNIAUTH_CLIENT_ID=your_client_id_here
UNIAUTH_CLIENT_SECRET=your_client_secret_here

# ==================== 阿里云 ASR 配置 ====================
# 用于语音转文字 (从阿里云百炼平台获取)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
